# Supabase connection — copy this file to `.env.local` and fill in the values
# from your Supabase project (Project Settings → API).

# Public — safe to expose to the browser. Governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — BYPASSES Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
